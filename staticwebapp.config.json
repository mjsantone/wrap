{
  "routes": [
    {
      "route": "/fonts.css",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/b/*",
      "rewrite": "/api/bpage"
    },
    {
      "route": "/library",
      "rewrite": "/library.html"
    },
    {
      "route": "/edit",
      "rewrite": "/editor.html"
    },
    {
      "route": "/gallery",
      "redirect": "/library",
      "statusCode": 301
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}